{
  "_comment": "Control-plane settings. The guard (harness/hooks/, this file) stays human-owned; see docs/autonomy-plan.md.",
  "baseUrl": "http://localhost:4173",
  "admission": {
    "passK": 5
  },
  "budgets": {
    "maxRequirementsPerRun": 3,
    "maxTriagePerRun": 5,
    "maxHealAttemptsPerTest": 2,
    "maxUsdPerRun": 5,
    "maxTurnsPerAgent": 30
  },
  "agents": {
    "command": "claude",
    "_note": "Agents run via the Claude Code CLI in headless mode (claude -p). Verify flags with `claude --help` for your installed version.",
    "models": {
      "qa-planner": "opus",
      "qa-generator": "sonnet",
      "qa-triage": "sonnet"
    }
  },
  "protectedPaths": [
    "sealed-acceptance/",
    ".claude/settings.json",
    ".claude/settings.local.json",
    "harness/hooks/",
    "harness/config.json"
  ],
  "healPolicy": {
    "maxTimeoutMs": 15000
  }
}
