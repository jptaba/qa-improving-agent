{
  "name": "self-improving-qa-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Harness-engineered, self-improving Playwright test agents with a sealed, requirements-only acceptance evaluator.",
  "scripts": {
    "aut": "node demo-aut/server.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/html",
    "check:results": "node harness/ci/fail-on-skip-or-flaky.mjs reports/results.json",
    "check:heal-diff": "node harness/hooks/heal-diff-check.mjs",
    "check:inventory": "node harness/ci/inventory-guard.mjs",
    "evaluate": "node sealed-acceptance/evaluator/run-evaluator.mjs --requirements requirements --url http://localhost:4173",
    "canary": "node harness/canary/run-canary.mjs",
    "orchestrate": "node harness/orchestrator/run.mjs",
    "orchestrate:dry": "node harness/orchestrator/run.mjs --dry-run",
    "orchestrate:no-agents": "node harness/orchestrator/run.mjs --no-agents",
    "selftest:hooks": "node harness/hooks/selftest.mjs",
    "contract:fuzz": "node scripts/contract-fuzz.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
