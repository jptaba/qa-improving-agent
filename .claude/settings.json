{
  "permissions": {
    "deny": [
      "Read(./sealed-acceptance/**)",
      "Edit(./sealed-acceptance/**)",
      "Edit(./requirements/**)",
      "Edit(./inventory/**)",
      "Edit(./harness/**)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./playwright.config.ts)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/protect-oracle.mjs\""
          }
        ]
      }
    ]
  }
}
